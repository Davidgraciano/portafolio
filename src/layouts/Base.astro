---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Monogram from '../components/Monogram.astro';
import { ui, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  altPath: string;
}
const { lang, title, description, altPath } = Astro.props;
const t = ui[lang];
const pageTitle = title ?? t.title;
const pageDescription = description ?? t.description;
const site = Astro.site ?? new URL('https://davidgraciano.vercel.app');
const canonical = new URL(Astro.url.pathname, site).href;
const altUrl = new URL(altPath, site).href;
const ogImage = new URL('/og.png', site).href;
const home = lang === 'es' ? '/' : '/en/';
const esUrl = lang === 'es' ? canonical : altUrl;
const enUrl = lang === 'en' ? canonical : altUrl;
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#111214" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="David Graciano" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('dg-theme') === 'claro') document.documentElement.dataset.theme = 'claro';
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="sig" href={home} aria-label="David Graciano">
          <Monogram size={30} />
          <span class="sig-name">David Graciano</span>
        </a>
        <nav class="nav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
          <span class="nav nav-links">
            <a href={`${home}#casos`}>{t.nav.cases}</a>
            <a href={`${home}#experiencia`}>{t.nav.experience}</a>
            <a href={`${home}#stack`}>{t.nav.stack}</a>
            <a href={`${home}#contacto`}>{t.nav.contact}</a>
          </span>
          <span class="tools">
            <a class="icon-btn" href={altPath} hreflang={lang === 'es' ? 'en' : 'es'} aria-label={t.switchLangLabel}>{t.switchLang}</a>
            <button class="icon-btn" type="button" id="theme-toggle" aria-label={t.themeLabel}>
              <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
              <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            </button>
          </span>
        </nav>
      </div>
      <div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© 2026 David Graciano · {t.location}</span>
        <span>{t.footer}</span>
      </div>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'claro' ? 'grafito' : 'claro';
        if (next === 'claro') root.dataset.theme = 'claro'; else delete root.dataset.theme;
        try { localStorage.setItem('dg-theme', next); } catch (e) {}
      });
    </script>
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
