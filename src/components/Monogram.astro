  <g fill="none" stroke="currentColor" stroke-width="5.5">
    <path d="M8 16V48A16 16 0 0 0 8 16Z" />
    <path d="M51.31 20.69A16 16 0 1 0 56 32H46" />
  </g>
  <rect class="node" x="38" y="28" width="8" height="8" />
</svg>
