---
import Base from '../../../layouts/Base.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { cases, casePath } from '../../../data/site';

export function getStaticPaths() {
  return cases.map((item) => ({ params: { slug: item.slug.en }, props: { item } }));
}
const { item } = Astro.props;
---
<Base lang="en" altPath={casePath(item, 'es')} title={`${item.title.en} · David Graciano`} description={item.summary.en}>
  <CaseStudy lang="en" item={item} />
</Base>
